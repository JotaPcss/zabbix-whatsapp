# Acrescente estas linhas ao ~/.hermes/.env do usuário que roda o Hermes.
# Depois: hermes gateway restart  (ou reinicie o serviço)

# ---------- WhatsApp (ponte Baileys embutida no Hermes) ----------
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot

# Quem pode CONVERSAR com o agente no privado: só a equipe técnica.
# Números com DDI e DDD, sem "+" e sem espaços, separados por vírgula.
# (Isto não afeta os alertas: eles são envios de saída e não dependem desta lista.)
WHATSAPP_ALLOWED_USERS=5511999990001,5511999990002

# Grupos em que o agente RESPONDE: só o grupo interno de plantão.
# Os grupos dos clientes recebem alertas e relatórios, mas o agente não lê nem responde neles.
WHATSAPP_GROUP_POLICY=allowlist
WHATSAPP_GROUP_ALLOWED_USERS=120363000000000000@g.us
# No grupo, o agente só responde quando for mencionado (@).
WHATSAPP_REQUIRE_MENTION=true

# Ligue temporariamente para descobrir os JIDs dos grupos (ficam em bridge.log); depois desligue.
# WHATSAPP_DEBUG=true

# ---------- Webhook (recebe os alertas do Zabbix) ----------
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8644

# ---------- Modelo de IA (só necessário para a conversa com o agente) ----------
# Alertas e relatórios NÃO usam IA. Escolha um provedor quando for usar a parte de conversa:
# OPENROUTER_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# Ou modelo local com Ollama: veja a seção "Modelo de IA" do TUTORIAL.
